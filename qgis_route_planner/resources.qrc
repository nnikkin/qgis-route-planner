<RCC>
  <qresource prefix="/plugins/qgis_route_planner">
    <file alias="cross_white">png_resources/icons/cross-white.png</file>
    <file alias="plugin_icon">png_resources/icons/map-pin.png</file>
  </qresource>
  <qresource prefix="map_icons">
    <file alias="map_add_point">png_resources/icons/marker--plus.png</file>
    <file alias="map_move">png_resources/icons/arrow-move.png</file>
    <file alias="map_zoomin">png_resources/icons/magnifier-zoom-in.png</file>
    <file alias="map_zoomout">png_resources/icons/magnifier-zoom-out.png</file>
    <file alias="map_marker">png_resources/icons/marker.png</file>
    <file alias="map_restrict">png_resources/icons/prohibition-button.png</file>
  </qresource>
  <qresource prefix="route_list_icons">
    <file alias="save_icon">png_resources/icons/disk.png</file>
  </qresource>
</RCC>
